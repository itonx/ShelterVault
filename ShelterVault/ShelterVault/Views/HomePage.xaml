<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ShelterVault.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ShelterVault.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ShelterVault.Models"
    Margin="{ThemeResource ShelterVaultPageContentThickness}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid Padding="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ItemsView
            x:Name="CredentialList"
            HorizontalAlignment="Center"
            ItemsSource="{Binding Credentials, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
            SelectionMode="Single">
            <ItemsView.Layout>
                <UniformGridLayout
                    MaximumRowsOrColumns="3"
                    MinColumnSpacing="20"
                    MinRowSpacing="5" />
            </ItemsView.Layout>
            <ItemsView.ItemTemplate>
                <DataTemplate x:DataType="models:CredentialsViewItem">
                    <ItemContainer DoubleTapped="ItemContainer_DoubleTapped">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="350" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid
                                Margin="25,0,0,0"
                                Padding="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource CredentialsIcon.Background}"
                                BorderBrush="{ThemeResource CredentialsIcon.Border}"
                                BorderThickness="2"
                                CornerRadius="10">
                                <FontIcon
                                    FontSize="65"
                                    Foreground="{ThemeResource CredentialsIcon.Foreground}"
                                    Glyph="&#xE705;" />
                            </Grid>
                            <Grid
                                Grid.Column="1"
                                Padding="10"
                                RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource ShelterVaultForeground}"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <Grid
                                    Grid.Row="1"
                                    BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
                                    BorderThickness="0,0,0,0"
                                    ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Foreground="{ThemeResource ShelterVaultForeground}"
                                        Glyph="&#xE77B;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Foreground="{ThemeResource ShelterVaultForeground}"
                                        Text="{x:Bind Username}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="2"
                                        Margin="5,0,0,0"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        Style="{ThemeResource ButtonRevealStyle}">
                                        <FontIcon
                                            Margin="0"
                                            FontSize="18"
                                            Foreground="{ThemeResource ShelterVaultForeground}"
                                            Glyph="&#xE8C8;" />
                                    </Button>
                                </Grid>
                                <Grid
                                    Grid.Row="2"
                                    BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
                                    BorderThickness="0,0,0,0"
                                    ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Foreground="{ThemeResource ShelterVaultForeground}"
                                        Glyph="&#xE8D7;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Foreground="{ThemeResource ShelterVaultForeground}"
                                        Text="**********" />
                                    <Button
                                        Grid.Column="2"
                                        Margin="5,0,0,0"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        Style="{ThemeResource ButtonRevealStyle}">
                                        <FontIcon
                                            Margin="0"
                                            FontSize="18"
                                            Foreground="{ThemeResource ShelterVaultForeground}"
                                            Glyph="&#xE8C8;" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Grid>
                    </ItemContainer>
                </DataTemplate>
            </ItemsView.ItemTemplate>
        </ItemsView>
    </Grid>
</Page>