<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ShelterVault.Views.VaultMigrationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ShelterVault.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Visibility="{Binding DisplayArgonMigration, Mode=OneWay}"
    mc:Ignorable="d">

    <Grid MinHeight="100" Margin="0,10">
        <StackPanel Spacing="10">
            <TextBlock
                x:Uid="Argon2MigrationTitle"
                HorizontalAlignment="Left"
                Foreground="{ThemeResource ShelterVaultForeground}"
                Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{Binding VaultMigrationMessage, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    x:Uid="Argon2Upgrade"
                    Command="{Binding MigrateToArgon2Command}"
                    Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
